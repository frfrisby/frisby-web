<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.frisby.web</groupId>
        <artifactId>frisby-web</artifactId>
        <version>1.5.5-SNAPSHOT</version>
    </parent>

    <artifactId>virtual-threads-smoke-tests</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>

    <description>
        Non-published, JDK 21+-only smoke tests proving Client, Server, and SseListener
        correctly dispatch onto a caller-supplied virtual-thread executor
        (Executors.newVirtualThreadPerTaskExecutor()).

        Only reactored in when building with a JDK 21+ toolchain (see the
        "virtual-thread-tests" profile in the root POM) so that the normal Java 17
        build/test cycle never attempts to compile virtual-thread APIs unavailable under
        --release 17.  Not deployed to any remote repository.  Never listed in the BOM.
    </description>

    <properties>
        <!-- This module is never deployed to a remote repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- Skip Javadoc generation — this is an internal smoke-test module, not a published artifact. -->
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>client-sse</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>server-sse</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>jackson-serializer</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestLogging only — this module hand-rolls its own single JAX-RS resource
             rather than depending on test-support's standard resource set. -->
        <dependency>
            <groupId>software.frisby.web</groupId>
            <artifactId>test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Routes Jetty's SLF4J log output through java.util.logging so that Jetty
            logs are visible in tests and the SLF4J "no providers found" warning is
            silenced.  Test-scoped only.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Overrides the inherited release-17 default — this module's test
                         sources call Executors.newVirtualThreadPerTaskExecutor() (JDK 21+).
                         Safe to hardcode rather than parameterize: this whole module is only
                         ever reactored in by the root POM's "virtual-thread-tests" profile,
                         which itself only activates on a JDK 21+ toolchain (see root pom.xml). -->
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Overrides the inherited default (derived from the hyphenated
                                 artifactId, which is not a valid Java module name). This
                                 module is never used as a JPMS module — it exists purely to
                                 hold test sources — so the exact value is unimportant beyond
                                 being syntactically valid. -->
                            <Automatic-Module-Name>software.frisby.web.vthreads</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} preserves the JaCoCo agent argument injected at prepare-agent. -->
                    <argLine>@{argLine}
                        -Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>


